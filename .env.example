# --- IA: al menos una de las dos claves ---
# Groq (https://console.groq.com/keys) -> motor principal, muy rápido
GROQ_API_KEY=tu_clave_groq
# Google AI Studio (https://aistudio.google.com/apikey) -> respaldo
GEMINI_API_KEY=tu_clave_gemini

# --- Base de datos ---
# Local:  mongodb://127.0.0.1:27017/progdidactai
# Atlas:  mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/?appName=<app>
MONGODB_URI=mongodb://127.0.0.1:27017/progdidactai

# --- Opcionales: ajuste fino del motor de IA ---
# Orden de la cascada de proveedores (cambia al que esté saturado)
AI_PROVIDER_ORDER=gemini,groq
# Modelos a probar por proveedor, en orden (separados por comas).
# Estos son los modelos verificados con las cuentas gratuitas.
#   Groq: llama-3.3-70b-versatile ya NO existe (404). Usa gpt-oss.
#   Gemini: 2.5-flash / 2.5-flash-lite ya NO están disponibles para cuentas
#           nuevas (404). Usa la serie 3.x.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Reintentos por modelo antes de saltar al siguiente proveedor
AI_MAX_ATTEMPTS=3
AI_ERROR_COOLDOWN_MS=2000
AI_MAX_BACKOFF_MS=8000
AI_TIMEOUT_MS=120000
# Tope de tokens de salida (el máximo real de ambas APIs es 65536)
GROQ_MAX_TOKENS=32768
GEMINI_MAX_TOKENS=65536
# Tamaño de los fragmentos en los que se trocea un documento largo
AI_CHUNK_CHARS=14000